  "schema": [
    {
      "op_type": "AveragePool",
      "version": 7,
      "attributes": {
        "auto_pad": {"type": "string8"}, // "SAME_UPPER", "SAME_LOWER", "VALID"
        "count_include_pad": {"type": "int64"}, // 1 if counting pad pixels for divisor.
        "kernel_shape": {"type": "int64"}, // list
        "pads": {"type": "int64"}, // list 2x (input dimension count - 2), or all 0's if absent.
        "strides": {"type": "int64"} // list
      },
      "inputs": {"X": {"type": "T"}}, // N C D...
      "outputs": {"Y": {"type": "T"}},
      "types": {"T": ["float32", "float16", "float64"]}
    },
    // v10 adds ceil_mode to ceil instead of floor the output shape.
    {
      "op_type": "AveragePool",
      "version": 10, // https://github.com/onnx/onnx/blob/master/docs/Changelog.md#averagepool-10
      "attributes": {
        "auto_pad": {"type": "string8"}, // "SAME_UPPER", "SAME_LOWER", "VALID"
        "ceil_mode": {"type": "int64"}, // round up (ceil) output shape if 1, else floor if 0. https://github.com/onnx/onnx/pull/1860
        "count_include_pad": {"type": "int64"}, // 1 if counting pad pixels for divisor.
        "kernel_shape": {"type": "int64"}, // list
        "pads": {"type": "int64"}, // list 2x (input dimension count - 2), or all 0's if absent.
        "strides": {"type": "int64"} // list
      },
      "inputs": {"X": {"type": "T"}}, // N C D...
      "outputs": {"Y": {"type": "T"}},
      "types": {"T": ["float32", "float16", "float64"]}
    },
    // v11 is identical to v10. The version was incremented because of documentation clarification on optional default values.
    {
      "op_type": "AveragePool",
      "version": 11, // https://github.com/onnx/onnx/blob/master/docs/Changelog.md#averagepool-10
      "attributes": {
        "auto_pad": {"type": "string8"}, // "SAME_UPPER", "SAME_LOWER", "VALID"
        "ceil_mode": {"type": "int64"}, // round up (ceil) output shape if 1, else floor if 0. https://github.com/onnx/onnx/pull/1860
        "count_include_pad": {"type": "int64"}, // 1 if counting pad pixels for divisor.
        "kernel_shape": {"type": "int64"}, // list
        "pads": {"type": "int64"}, // list 2x (input dimension count - 2), or all 0's if absent.
        "strides": {"type": "int64"} // list
      },
      "inputs": {"X": {"type": "T"}}, // N C D...
      "outputs": {"Y": {"type": "T"}},
      "types": {"T": ["float32", "float16", "float64"]}
    }
  ]
