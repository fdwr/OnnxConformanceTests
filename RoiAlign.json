  "schema": [
    {
      "op_type": "RoiAlign",
      "version": 10,
      "attributes": {
        "mode": {"type": "string8"}, // "avg", "max"; default = "avg"
        "output_height": {"type": "int64"}, // (default 1) Output Y's height (it must match).
        "output_width": {"type": "int64"}, // (default 1) Output Y's width (it must match).
        "sampling_ratio": {"type": "int64"}, // (default is 0) Number of sampling points in the interpolation grid used to compute the output value of each pooled output bin. If > 0, then exactly sampling_ratio x sampling_ratio grid points are used. If == 0, then an adaptive number of grid points are used (computed as ceil(roi_width / output_width), and likewise for height). Default is 0.
        "spatial_scale": {"type": "float32"} // (default is 1) Multiplicative spatial scale factor to translate ROI coordinates from their input spatial scale to the scale used when pooling, i.e., spatial scale of the input feature map X relative to the input image. E.g.; default is 1.0f.
      },
      "inputs": {
        "X": {"type": "T1"}, // Input data tensor from the previous operator; 4-D feature map of shape (N, C, H, W), where N is the batch size, C is the number of channels, and H and W are the height and the width of the data.
        "rois": {"type": "T1"}, // RoIs (Regions of Interest) to pool over; rois is 2-D input of shape (num_rois, 4) given as [[x1, y1, x2, y2], ...]. The RoIs' coordinates are in the coordinate system of the input image. Each coordinate set has a 1:1 correspondence with the 'batch_indices' input.
        "batch_indices": {"type": "T2"} // 1-D tensor of shape (num_rois,) with each element denoting the index of the corresponding image in the batch.
      },
      "outputs": {
        "Y": {"type": "T1"}
      },
      "types": {
          "T1": ["float32", "float16", "float64"],
          "T2": ["int64"]
      }
    },
    {
      "op_type": "RoiAlign",
      "version": 16,
      "attributes": {
        "coordinate_transformation_mode": {"type":"string8"}, //(default half_pixel) Whether to pixel shift the input coordiates by -0.5.
        "mode": {"type": "string8"}, // "avg", "max"; default = "avg"
        "output_height": {"type": "int64"}, // (default 1) Output Y's height (it must match).
        "output_width": {"type": "int64"}, // (default 1) Output Y's width (it must match).
        "sampling_ratio": {"type": "int64"}, // (default is 0) Number of sampling points in the interpolation grid used to compute the output value of each pooled output bin. If > 0, then exactly sampling_ratio x sampling_ratio grid points are used. If == 0, then an adaptive number of grid points are used (computed as ceil(roi_width / output_width), and likewise for height). Default is 0.
        "spatial_scale": {"type": "float32"} // (default is 1) Multiplicative spatial scale factor to translate ROI coordinates from their input spatial scale to the scale used when pooling, i.e., spatial scale of the input feature map X relative to the input image. E.g.; default is 1.0f.
      },
