      "op_type": "Split",
      "version": 13,
      "attributes": {
        "axis": {"type": "int64"} // default = 0
      },
      "inputs": {
        "input": {"type": "T"},
        "split": {"type": "int64"} // list of ints
      },
      "outputs": { // variadic
        "output_0": {"type": "T"},
        "output_1": {"type": "T"},
        "output_2": {"type": "T"},
        "output_3": {"type": "T"}
      },
      "types": {"T": ["float32", "float16", "float64", "uint8", "uint16", "uint32", "int8", "int16", "int32", "string8", "bfloat16"]}
    },
    {
      "op_type": "Relu",
      "version": 1,
      "attributes": {},
      "inputs": {"input": {"type": "T"}},
      "outputs": {"output": {"type": "T"}},
      "types": {"T": ["float32", "float16", "float64", "uint8", "uint16", "uint32", "uint64", "int8", "int16", "int32", "int64", "bool8", "string8"]}
    },
    {
      "op_type": "Split",
      "version": 18,
      "attributes": {
        "axis": {"type": "int64"}, // default = 0
        "num_outputs": {"type": "int64"}
      },
      "inputs": {
        "input": {"type": "T"},
        "split": {"type": "int64"} // list of ints
      },
      "outputs": { // variadic
        "output_0": {"type": "T"},
        "output_1": {"type": "T"},
        "output_2": {"type": "T"},
        "output_3": {"type": "T"}
      },
      "types": {"T": ["float32", "float16", "float64", "uint8", "uint16", "uint32", "int8", "int16", "int32", "string8", "bfloat16"]}
    }
  ]
