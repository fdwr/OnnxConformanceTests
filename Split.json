      },
      "inputs": {"input": {"type": "T"}},
      "outputs": { // variadic
        "output_0": {"type": "T"},
        "output_1": {"type": "T"},
        "output_2": {"type": "T"},
        "output_3": {"type": "T"}
      },
      "types": {"T": ["float32", "float16", "float64", "uint8", "uint16", "uint32", "int8", "int16", "int32" ]}
    },
    {
