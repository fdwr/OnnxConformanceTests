      "version": 4,
      "attributes": {
        "axis": {"type": "int64"}
      },
      "inputs": { // Variadic
        "input_0": {"type": "T"},
        "input_1": {"type": "T"}
      }, 
      "outputs": {"concat_result": {"type": "T"}},
      "types": {"T": ["float32", "float16", "float64", "uint8", "uint16", "uint32", "uint64", "int8", "int16", "int32", "int64", "bool8"]}
    },
