        "X": {"type": "T1"},
        "roi": {"type": "T2"}, // Floating point normalized extents, [start0, start1, .. end0, end1 ...].
        "scales": {"type": "float32"}, // One for each dimension, where: =1 unchanged, >1 scale bigger, <1 scale smaller
        "sizes": {"type": "int64"} // Mutually exclusive to scales.
