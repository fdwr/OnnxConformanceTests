    // Slice-10 1D negative steps
    {
      "op_type": "Slice",
      "version": 10,
      "data":   [1,2,3,4,5,6,7,8,9],
      "starts": [9],
      "ends":   [0],
      "axes":   [0],
      "steps":  [-2],
      "output": [9,7,5,3],
      "T": "float32",
      "Tind": "int32"
    },
    // Slice-10 1D negative steps end inclusive
    // ONNX has no way to properly slice the whole range with negative steps,
    // because the slice window extents are off by one, and using a negative
    // value for the end point is reinterpreted as a positive index from the
    // back. So a special sentinel value (INT_MIN) was added to ONNX.
    {
      "op_type": "Slice",
      "version": 10,
      "data":   [1,2,3,4,5,6,7,8,9],
      "starts": [2147483647],
      "ends":   [-2147483648],
      "axes":   [0],
      "steps":  [-2],
      "output": [9,7,5,3,1],
      "T": "float32",
      "Tind": "int32"
    },
