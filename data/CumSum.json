{
  // https://github.com/onnx/onnx/blob/master/docs/Operators.md#CumSum
  // https://github.com/onnx/onnx/pull/2030
  "tests": [
    {
      "graph_name": "CumSum-11 axis 0 float32",
      "op_type": "CumSum",
      "x": [1, -2, 2, 3, 4],
      "axis": 0,
      "output": [1, -1, 1, 4, 8],
      "T": "float32",
      "verification": {"ulp": 0}
    },
    {
      "graph_name": "CumSum-11 axis 0 int32",
      "op_type": "CumSum",
      "x": [1, -2, 2, 3, 4],
      "axis": 0,
      "output": [1, -1, 1, 4, 8],
      "T": "int32",
      "verification": {"ulp": 0}
    },
    {
      "graph_name": "CumSum-11 axis 0 exclusive reverse uint32",
      "op_type": "CumSum",
      "version": 14,
      "x": [1, 2, 3],
      "axis": 0,
      "exclusive": 1,
      "reverse": 1,
      "output": [5, 3, 0],
      "T": "uint32",
      "verification": {"ulp": 0, "executor_filter": ".*Cpu"}
    },
    {
      "graph_name": "CumSum-11 axis 0 exclusive reverse int64",
      "op_type": "CumSum",
      "x": [1, 2, 3],
      "axis": 0,
      "exclusive": 1,
      "reverse": 1,
      "output": [5, 3, 0],
      "T": "int64",
      "verification": {"ulp": 0}
    },
    {
      "graph_name": "CumSum-11 axis 0 negative int64",
      "op_type": "CumSum",
      "x": [1, -2, 2, 3, 4],
      "axis": 0,
      "output": [1, -1, 1, 4, 8],
      "T": "int64",
      "verification": {"ulp": 0}
    },
    {
      "graph_name": "CumSum-11 axis 0 exclusive reverse uint64",
      "op_type": "CumSum",
      "version": 14,
      "x": [1, 2, 3],
      "axis": 0,
      "exclusive": 1,
      "reverse": 1,
      "output": [5, 3, 0],
      "T": "uint64",
      "verification": {"ulp": 0, "executor_filter": ".*Cpu"}
    },
    {
      "graph_name": "CumSum-11 axis 0 int8",
      "op_type": "CumSum",
      "x": [1, -2, 2, 3, 4],
      "axis": 0,
      "output": [1, -1, 1, 4, 8],
      "T": "int8",
      "verification": {"ulp": 0, "executor_filter": ".*"} // int8 is not registered in ORT.
    },
    {
      "graph_name": "CumSum-11 axis 0 exclusive float32",
      "op_type": "CumSum",
      "x": [1, 2, 3],
      "axis": 0,
      "exclusive": 1,
      "output": [0, 1, 3],
      "T": "float32",
      "verification": {"ulp": 0}
    },
    {
      "graph_name": "CumSum-11 axis 0 reverse float32",
      "op_type": "CumSum",
      "x": [1, 2, 3],
      "axis": 0,
      "exclusive": 0,
      "reverse": 1,
      "output": [6, 5, 3],
      "T": "float32",
      "verification": {"ulp": 0}
    },
    {
      "graph_name": "CumSum-11 axis 0 exclusive reverse float32",
      "op_type": "CumSum",
      "x": [1, 2, 3],
      "axis": 0,
      "exclusive": 1,
      "reverse": 1,
      "output": [5, 3, 0],
      "T": "float32",
      "verification": {"ulp": 0}
    },
    {
      "graph_name": "CumSum-14 axis 0 float16",
      "op_type": "CumSum",
      "version": 14,
      "x": [1, -2, 2, 3, 4],
      "axis": 0,
      "output": [1, -1, 1, 4, 8],
      "T": "float16",
      "verification": {"ulp": 0}
    }
  ],

  "schema": [
    {
      "op_type": "CumSum",
      "version": 11,
      "attributes": {
        "exclusive": {"type": "int64"}, // Default = 0
        "reverse": {"type": "int64"} // Default = 0
      },
      "inputs": {
        "x": {"type": "T"},
        "axis": {"type": "T2"} // Default = 0. Negative means count from back.
      },
      "outputs": {
        "output": {"type": "T"}
      },
      "types": {
        "T": ["float32", "float64", "uint32", "uint64", "int32", "int64"],
        "T2": ["int32", "int64"]
      }
    },
    {
      "op_type": "CumSum",
      "version": 14,
      "attributes": {
        "exclusive": {"type": "int64"}, // Default = 0
        "reverse": {"type": "int64"} // Default = 0
      },
      "inputs": {
        "x": {"type": "T"},
        "axis": {"type": "T2"} // Default = 0. Negative means count from back.
      },
      "outputs": {
        "output": {"type": "T"}
      },
      "types": {
        "T": ["float32", "float16", "float64", "uint32", "uint64", "int32", "int64"],
        "T2": ["int32", "int64"]
      }
    }
  ]
}
