  "schema": [
    {
      // If x >  lambd, y = x - bias;
      // If x < -lambd, y = x + bias;
      // Otherwise, y = 0.
      "op_type": "Shrink",
      "version": 9,
      "attributes": {
        "bias": {"type": "float32"}, // default bias = 0
        "lambd": {"type": "float32"} // default threshold = 0.5
      },
      "inputs": {"input": {"type": "T"}},
      "outputs": {"output": {"type": "T"}},
      "types": {"T": ["float32", "float16", "float64", "int32", "int16", "int8", "uint32", "uint16", "uint8"]}
    }
  ]
