{
  "tests": [
    // 2x2 with stride 2x2. p = 1.
    {
      "op_type": "LpPool",
      "version": 2,
      "auto_pad": "VALID",
      "kernel_shape": [2,2],
      "p": 1,
      "pads": [0,0, 0,0],
      "strides": [2,2],
      "X": [[[[ 0, 3, 0, 4],
              [ 4, 0, 3, 0],
              [ 4, 0,-3, 0],
              [ 0, 3, 0, 4]]]],
      "Y": [[[[ 7, 7],
              [ 7, 7]]]],
      "T": "float32"
    },
    // 2x2 with stride 2x2. p = 1.
    {
      "op_type": "LpPool",
      "version": 2,
      "auto_pad": "VALID",
      "kernel_shape": [2,2],
      "p": 2,
      "pads": [0,0, 0,0],
      "strides": [2,2],
      "X": [[[[ 0, 3, 0, 4],
              [ 4, 0, 3, 0],
              [ 4, 0,-3, 0],
              [ 0, 3, 0, 4]]]],
      "Y": [[[[ 5, 5],
              [ 5, 5]]]],
      "T": "float32"
    },
    // float32.
    {
      "op_type": "LpPool",
      "version": 2,
      "auto_pad": "VALID",
      "kernel_shape": [3,2],
      "p": 2,
      "pads": [0,0, 0,0],
      "strides": [1,1],
      "X": [[[[ 1, 0, 3],
              [ 0, 5, 1],
              [ 3, 1, 0],
              [ 1, 0, 3]]]],
      "Y": [[[[ 6, 6],
              [ 6, 6]]]],
      "T": "float32"
    },
    // float16.
    {
      "op_type": "LpPool",
      "version": 2,
      "auto_pad": "VALID",
      "kernel_shape": [3,2],
      "p": 2,
      "pads": [0,0, 0,0],
      "strides": [1,1],
      "X": [[[[ 1, 0, 3],
              [ 0, 5, 1],
              [ 3, 1, 0],
              [ 1, 0, 3]]]],
      "Y": [[[[ 6, 6],
              [ 6, 6]]]],
      "T": "float16"
    },
    // 5D tensor with 1x3x2 kernel.
    {
      "op_type": "LpPool",
      "version": 2,
      "auto_pad": "VALID",
      "kernel_shape": [1,3,2],
      "p": 2,
      "pads": [0,0, 0,0, 0,0],
      "strides": [1,1,1],
      "X": [[[[[ 1, 0, 3],
               [ 0, 5, 1],
               [ 3, 1, 0],
               [ 1, 0, 3]],
              [[ 7, 1, 0],
               [ 0, 7, 7],
               [ 1, 0, 1],
               [ 7, 1, 0]]]]],
      "Y": [[[[[ 6, 6],
               [ 6, 6]],
              [[10,10],
               [10,10]]]]],
      "T": "float32"
    },
    // 5D tensor with 2x3x2 kernel.
    {
      "op_type": "LpPool",
      "version": 2,
      "auto_pad": "VALID",
      "kernel_shape": [2,3,2],
      "p": 2,
      "pads": [0,0, 0,0, 0,0],
      "strides": [1,1,1],
      "X": [[[[[ 1, 2, 3],
               [ 0, 5, 1],
               [ 3, 1, 0],
               [ 1, 2, 3]],
              [[ 7, 1, 2],
               [ 2, 7, 7],
               [ 1, 0, 1],
               [ 7, 1, 2]]]]],
      "Y": [[[[[12,12],
               [12,12]]]]],
      "T": "float32"
    },
    // LpPool 11 2x2 with stride 2x2. p = 1.
    {
      "op_type": "LpPool",
      "version": 11,
      "auto_pad": "VALID",
      "kernel_shape": [2,2],
      "p": 1,
      "pads": [0,0, 0,0],
      "strides": [2,2],
      "X": [[[[ 0, 3, 0, 4],
              [ 4, 0, 3, 0],
              [ 4, 0,-3, 0],
              [ 0, 3, 0, 4]]]],
      "Y": [[[[ 7, 7],
              [ 7, 7]]]],
      "T": "float32"
    }
  ],

  "schema": [
    {
      "op_type": "LpPool",
      "version": 2,
      "attributes": {
        "auto_pad": {"type": "string8"}, // "SAME_UPPER", "SAME_LOWER", "VALID"
        "kernel_shape": {"type": "int64"}, // list of ints (required)
        "p": {"type": "int64"}, // default 2
        "pads": {"type": "int64"}, // list of ints. Defaults to 0's.
        "strides": {"type": "int64"} // list of ints. Defaults to 1's.
      },
      "inputs": {"X": {"type": "T"}},
      "outputs": {"Y": {"type": "T"}},
      "types": {"T": ["float32", "float16", "float64"]}
    },
    {
      "op_type": "LpPool",
      "version": 11, // No difference from 10 (except clarification that strides default to 1).
      "attributes": {
        "auto_pad": {"type": "string8"}, // "SAME_UPPER", "SAME_LOWER", "VALID"
        "kernel_shape": {"type": "int64"}, // list of ints (required)
        "p": {"type": "int64"}, // default 2
        "pads": {"type": "int64"}, // list of ints. Defaults to 0's.
        "strides": {"type": "int64"} // list of ints. Defaults to 1's.
      },
      "inputs": {"X": {"type": "T"}},
      "outputs": {"Y": {"type": "T"}},
      "types": {"T": ["float32", "float16", "float64"]}
    }
  ]
}
