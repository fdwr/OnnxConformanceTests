{
  // An elementwise immediate if that returns elements from X or Y depending on the corresponding condition,
  // X if true, Y if false.
  //
  // Each input tensor is broadcastable like other elementwise operators.
  "tests": [
    {
      "graph_name": "Where float32",
      "op_type": "Where",
      "condition": [true, false, true],
      "X": [1, 2, 3],
      "Y": [4, 5, 6],
      "output": [1, 5, 3],
      "T": "float32"
    },
    {
      "graph_name": "Where 2D float32",
      "op_type": "Where",
      "condition": [[true, false], [true, true]],
      "X": [[1, 2], [3, 4]],
      "Y": [[9, 8], [7, 6]],
      "output": [[1, 8], [3, 4]],
      "T": "float32"
    },
    {
      "graph_name": "Where broadcast scalar",
      "op_type": "Where",
      "condition": [true, false, true],
      "X": 1,
      "Y": [4, 5, 6],
      "output": [1, 5, 1],
      "T": "float32"
    },
    {
      "graph_name": "Where broadcast 2D",
      "op_type": "Where",
      "condition": [true, false, true],
      "X": [[1, 2, 3]], // dims [1,3]
      "Y": [[4],        // dims [3,1]
            [5],
            [6]],
      "output": [[1, 4, 3],
                 [1, 5, 3],
                 [1, 6, 3]],
      "T": "float32"
    },

