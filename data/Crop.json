  ],

  "schema": [
    {
      "op_type": "Crop",
      "version": 1,
      "attributes": {
        "border": {"type": "int64"}, // list, {leftBorder, topBorder, rightBorder, bottomBorder}
        "scale": {"type": "int64"} // list, optional, 1D values of {height, width}
      },
      "inputs": {
        "input": {"type": "T"} // [N,C,H,W]
      },
      "outputs": {
        "output": {"type": "T"}
      },
      "types": {"T": ["float32", "float16", "float64"]}
    }
  ]
