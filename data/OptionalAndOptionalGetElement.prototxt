ir_version: 8
producer_name: "backend-test"
graph {
  name: "test_optional_get_element_with_add"
  node {
    op_type: "Optional"
    input: "optional_input"
    output: "optional_output"
    attribute {
      name: "type"
      tp {
        tensor_type {
          elem_type: 1
          shape {
            dim {
              dim_value: 4
            }
          }
        }
      }
      type: TYPE_PROTO
    }
  }
  node {
    op_type: "OptionalGetElement"
    input: "optional_output"
    output: "get_element_output"
  }
  node {
    op_type: "Add"
    input: "get_element_output"
    input: "nonoptional_input"
    output: "output"
  }
  input {
    name: "optional_input"
    type {
      tensor_type {
        elem_type: 1
        shape {
          dim {
            dim_value: 4
          }
        }
      }
    }
  }
  input {
    name: "nonoptional_input"
    type {
      tensor_type {
        elem_type: 1
        shape {
          dim {
            dim_value: 4
          }
        }
      }
    }
  }
  output {
    name: "output"
    type {
      tensor_type {
        elem_type: 1
        shape {
          dim {
            dim_value: 4
          }
        }
      }
    }
  }
}
opset_import {
  version: 15
}
