        "stash_type": {"type": "int64"}
      },
      "inputs": {
        "X": {"type": "T1"},
        "scale": {"type": "T2"},
        "B": {"type": "T2"}
      },
      "outputs": {
        "Y": {"type": "T2"},
        "Mean": {"type": "T3"},
        "InvStdDev": {"type": "T3"}
      },
      "types": {
        "T1": ["float32", "float16", "bfloat16", "float64"],
