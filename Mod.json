  "schema": [
    {
      "op_type": "Mod",
      "version": 10,
      "attributes": {
        // When fmod = 0: result = x - (y * floor(x / y)). Result sign follows the divisor.
        // When fmod = 1: result = x - (y * trunc(x / y)). Result sign follows the dividend.
        "fmod": {"type": "int64"} // Default = 0. Must be one with float* types.
      },
      "inputs": {
        "A": {"type": "T"},
        "B": {"type": "T"}
      },
      "outputs": {
        "C": {"type": "T"}
      },
      "types": {"T": ["float32", "float16", "float64", "uint8", "uint16", "uint32", "uint64", "int8", "int16", "int32", "int64"]}
    },
    {
      "op_type": "Mod",
      "version": 13,
      "attributes": {
        // When fmod = 0: result = x - (y * floor(x / y)). Result sign follows the divisor.
        // When fmod = 1: result = x - (y * trunc(x / y)). Result sign follows the dividend.
        "fmod": {"type": "int64"} // Default = 0. Must be one with float* types.
      },
      "inputs": {
        "A": {"type": "T"},
        "B": {"type": "T"}
      },
      "outputs": {
        "C": {"type": "T"}
      },
      "types": {"T": ["float32", "float16", "float64", "uint8", "uint16", "uint32", "uint64", "int8", "int16", "int32", "int64", "bfloat16"]}
    }
  ]
